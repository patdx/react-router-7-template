{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": [
      "./app/*",
      "./app/*.ts",
      "./app/*.tsx",
      "./app/*/index.ts"
    ]
  },
  "scripts": {
    "build": "wireit",
    "deploy": "wireit",
    "dev": "wireit",
    "postinstall": "pnpm typegen",
    "prepare": "husky",
    "start": "wireit",
    "typecheck": "wireit",
    "typegen": "wireit"
  },
  "lint-staged": {
    "*.json": [
      "jsonsort",
      "prettier --write"
    ],
    "*.{js,ts,jsx,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.13.18",
    "@radix-ui/react-slot": "1.5.0",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "5.2.2",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "0.2.3",
    "@playwright/mcp": "0.0.83",
    "@react-router/dev": "7.18.5",
    "@react-router/fs-routes": "7.18.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "json-sort-cli": "4.3.1",
    "lint-staged": "16.4.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "3.8.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "20.3.0",
    "vite": "7.3.7",
    "wireit": "0.15.0",
    "workerd": "1.20261031.1",
    "wrangler": "4.45.3"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "@esbuild-plugins/node-globals-polyfill": "$@esbuild-plugins/node-globals-polyfill",
      "esbuild": "$esbuild",
      "workerd": "$workerd"
    }
  },
  "wireit": {
    "build": {
      "command": "react-router build",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "app/**",
        "vite.config.ts",
        "react-router.config.ts"
      ],
      "output": [
        "build/**"
      ]
    },
    "deploy": {
      "command": "wrangler deploy",
      "dependencies": [
        "build"
      ]
    },
    "dev": {
      "command": "react-router dev",
      "files": [
        "app/**",
        "vite.config.ts"
      ],
      "service": true
    },
    "start": {
      "command": "wrangler dev",
      "service": true
    },
    "typecheck": {
      "command": "tsc --build",
      "dependencies": [
        "typegen"
      ],
      "files": [
        "tsconfig.json",
        "app/**/*.ts",
        "app/**/*.tsx",
        "worker-configuration.d.ts",
        ".react-router/**"
      ],
      "output": [
        "tsconfig.tsbuildinfo"
      ]
    },
    "typegen": {
      "command": "node scripts/update-date.js && wrangler types && react-router typegen",
      "files": [
        "app/**",
        "react-router.config.ts",
        ".env",
        "wrangler.json"
      ],
      "output": [
        "worker-configuration.d.ts",
        ".react-router/**"
      ]
    }
  }
}
